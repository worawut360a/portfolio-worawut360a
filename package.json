{
  "name": "portfolio-next",
  "version": "0.1.0",
  "private": true,
  "description": "แฟ้มสะสมผลงานครู วPA — Netlify + Turso + Google Drive",
  "scripts": {
    "db:schema": "turso db shell $TURSO_DB < db/schema.sql",
    "db:seed": "turso db shell $TURSO_DB < db/seed-core.sql",
    "db:demo": "turso db shell $TURSO_DB < db/seed-demo.sql",
    "db:local": "rm -f db/local.sqlite && sqlite3 db/local.sqlite < db/schema.sql && sqlite3 db/local.sqlite < db/seed-core.sql",
    "export:php": "php scripts/export-from-php.php",
    "test:media": "node --test scripts/media.test.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/bundle-sql.mjs && next dev -p 3100",
    "build": "node scripts/bundle-sql.mjs && next build",
    "start": "next start -p 3100",
    "admin:create": "node scripts/create-admin.mjs",
    "gen:sql": "node scripts/bundle-sql.mjs",
    "setup": "node scripts/setup.mjs",
    "test:db": "node --experimental-strip-types --test scripts/db-error.test.mjs",
    "test": "npm run test:media && npm run test:db"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "^15.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sweetalert2": "^11.26.25"
  }
}
